generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkflowRunScope {
  FULL
  SELECTED
  SINGLE
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum NodeRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model Workflow {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  nodes       Json
  edges       Json
  viewport    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  runs        WorkflowRun[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("workflows")
}

model WorkflowRun {
  id            String            @id @default(cuid())
  userId        String
  workflowId    String
  scope         WorkflowRunScope
  status        WorkflowRunStatus
  targetNodeIds Json?
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  durationMs    Int?
  errorMessage  String?

  workflow      Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeRuns      NodeRun[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([workflowId, startedAt(sort: Desc)])
  @@map("workflow_runs")
}

model NodeRun {
  id             String        @id @default(cuid())
  userId         String
  workflowRunId  String
  nodeId         String
  nodeType       String
  nodeLabel      String?
  status         NodeRunStatus
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  inputsUsed     Json?
  outputsGenerated Json?
  errorMessage   String?

  workflowRun    WorkflowRun   @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([workflowRunId])
  @@index([nodeId])
  @@map("node_runs")
}
